# Set these in the service and worker process environments; .env is not loaded automatically.
MOM_PROFILE=laptop8
MOM_ASR_BACKEND=faster_whisper
MOM_ASR_MODEL=whisper-large-v3-local
MOM_ASR_COMPUTE_TYPE=int8_float16
MOM_ASR_BATCH_SIZE=1
MOM_ASR_BEAM_SIZE=5
MOM_LLM_BACKEND=llama_cpp
MOM_LLM_MODEL=qwen35-4b-q4km-local
MOM_LLM_CONTEXT_SIZE=8192
MOM_LLM_MAX_OUTPUT_TOKENS=2048
# Optional; defaults are under the OS local application-data directory:
# MOM_MODEL_ROOT=C:/secure-mom/models
# MOM_DATA_DIR=C:/secure-mom/data
